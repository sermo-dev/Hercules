namespace hercules {
    [Throws=HerculesError]
    BlockInfo parse_block_header(string hex_header);
    string hercules_version();
    string script_backend();

    [Throws=HerculesError]
    void reset_database(string db_path);
};

dictionary BlockInfo {
    string block_hash;
    string prev_block_hash;
    string merkle_root;
    u32 version;
    u32 timestamp;
    string timestamp_human;
    u32 bits;
    u32 nonce;
};

dictionary PeerInfo {
    string addr;
    string user_agent;
    u32 height;
};

dictionary SyncStatus {
    u32 synced_headers;
    u32 peer_height;
    sequence<PeerInfo> peers;
    string active_peer_addr;
    boolean is_syncing;
    u32 validated_blocks;
    string? error;
};

dictionary SnapshotInfo {
    u32 height;
    u64 utxo_count;
    string utxo_hash;
};

dictionary BlockNotification {
    u32 height;
    string block_hash;
    string prev_block_hash;
    u32 timestamp;
    string timestamp_human;
    boolean validated;
    boolean header_validated;
    string? validation_error;
};

dictionary CatchUpStatus {
    boolean caught_up;
    u32 blocks_validated;
    u32 current_height;
    u32 target_height;
    string tip_block_hash;
    u32 tip_timestamp;
    string? error;
    boolean tip_disagreement;
    boolean invalid_chain_detected;
};

// Ticket 028: background wakes.

enum WakeOutcome {
    "Completed",
    "TransportSlow",
    "Busy",
    "Cancelled",
    "TimedOut",
    "Failed",
};

// Milliseconds since wake receipt.
dictionary WakePhaseTimings {
    u64? transport_ready_ms;
    u64? peers_ready_ms;
    u64? headers_checked_ms;
    u64? blocks_downloaded_ms;
    u64? validated_ms;
};

dictionary WakeReport {
    WakeOutcome outcome;
    CatchUpStatus? status;
    WakePhaseTimings timings;
    boolean preempted_sync;
    string? error;
    u64 elapsed_ms;
};

// Deadline + cancellation token for one wake. Create it the moment the
// wake arrives; cancel() is safe from any thread, at any time.
interface WakeBudget {
    constructor(u32 budget_ms);
    void cancel();
    boolean is_cancelled();
    u64 elapsed_ms();
    u64 remaining_ms();
};

dictionary TorStatus {
    boolean is_bootstrapped;
    u8 bootstrap_progress;
    string? onion_address;
};

dictionary MempoolStatus {
    u32 tx_count;
    u64 total_size;
    u64 max_size;
};

dictionary NodeStatus {
    u32 inbound_peers;
    u32 outbound_peers;
    u64 blocks_served;
    u64 txs_relayed;
};

dictionary TrustInfo {
    u32 snapshot_height;
    u32 validated_height;
    u32 forward_validated_blocks;
    string? muhash;
};

dictionary OwnTxReceipt {
    string txid;
    sequence<string> warnings;
};

dictionary OwnTxInfo {
    string txid;
    string status;
    u32? confirmed_height;
    string? related_txid;
    u64 first_sent_at;
    u64 last_sent_at;
    u64 next_attempt_at;
    u32 attempts;
    u32 seen_from_peers;
    u64 updated_at;
};

callback interface SyncCallback {
    void on_progress(SyncStatus status);
};

callback interface SnapshotCallback {
    // Return false to cancel the load.
    boolean on_progress(u64 loaded, u64 total);
};

interface HerculesNode {
    [Throws=HerculesError]
    constructor(string db_path, string? tor_data_dir);

    // Doesn't wait for Tor: bootstrap runs in the background (ticket 028).
    [Name=open, Throws=HerculesError]
    constructor(string db_path, string? tor_data_dir);

    [Throws=HerculesError]
    boolean wait_for_transport(u32 timeout_ms);

    WakeReport wake_catch_up(WakeBudget budget, u32 max_blocks, u32 min_block_ms);

    // Shut down for good (before a reset). True if the running session
    // ended within the timeout.
    boolean close(u32 timeout_ms);

    [Throws=HerculesError]
    SyncStatus get_status();

    [Throws=HerculesError]
    void start_header_sync(SyncCallback callback);

    [Throws=HerculesError]
    boolean needs_snapshot();

    [Throws=HerculesError]
    void check_snapshot_capacity();

    [Throws=HerculesError]
    SnapshotInfo load_snapshot(string snapshot_path, SnapshotCallback callback);

    [Throws=HerculesError]
    BlockNotification validate_latest_block(u32 timeout_secs);

    [Throws=HerculesError]
    CatchUpStatus catch_up_blocks(u32 max_blocks, u32 budget_secs);

    void stop_sync();
    void set_validation_paused(boolean paused);
    boolean is_validation_paused();
    TorStatus? get_tor_status();
    MempoolStatus get_mempool_status();
    NodeStatus get_node_status();

    [Throws=HerculesError]
    TrustInfo get_trust_info();

    [Throws=HerculesError]
    u32 reconsider_invalid_blocks();

    [Throws=HerculesError]
    string start_wallet_api();

    void stop_wallet_api();

    [Throws=HerculesError]
    string get_wallet_api_connection_string();

    [Throws=HerculesError]
    string rotate_wallet_auth_token();

    [Throws=BroadcastError]
    OwnTxReceipt submit_own_tx(string raw_tx_hex);

    [Throws=HerculesError]
    OwnTxInfo? own_tx_status(string txid);

    [Throws=HerculesError]
    sequence<OwnTxInfo> list_own_txs();
};

[Error]
interface HerculesError {
    SyncFailed(string msg);
    StorageError(string msg);
    NetworkError(string msg);
    TorError(string msg);
    SnapshotInvalid(string msg);
    NodeOpen(string msg);
};

[Error]
interface BroadcastError {
    Invalid(string msg);
    Consensus(string msg);
    NotYetFinal(string msg);
    NonStandard(string msg);
    FeeTooLow(string msg);
    AbsurdFee(string msg);
    Conflict(string msg);
    AlreadyKnown(string txid);
    NotSynced(string msg);
    Internal(string msg);
};
